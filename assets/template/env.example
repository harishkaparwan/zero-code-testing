# Copy this file to .env and edit. Nothing here is required for the default run.

# Which environment to test. Point at staging or localhost to avoid production bot protection.
BASE_URL=__BASE_URL__

# The exact page opened by "Given I open the app". Useful for apps hosted below /.
START_URL=__START_URL__

# Only needed for signed-in tests. Use a TEST account, never a personal one.
TEST_USER=
TEST_PASSWORD=

# Set to false to watch authorized tests run in a visible browser.
HEADLESS=true
